{
  "name": "ripple",
  "version": "0.1.0",
  "description": "Ripple (Runs with Gates) — collaborative control plane for humans and AI agents",
  "type": "module",
  "bin": {
    "ripple": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:css": "tailwindcss -i public/input.css -o public/styles.css --minify",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/engine.test.js dist-test/tests/oauth.test.js dist-test/tests/postgres.test.js",
    "test:static": "node scripts/check-ui-static.mjs",
    "test:e2e": "tsc -p tsconfig.test.json && node --test dist-test/tests/e2e.test.js",
    "test:ui": "python3 tests/ui_e2e.py",
    "test:all": "npm run build && npm run test:static && npm test && npm run test:e2e && npm run test:ui",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
