[
  {
    "type": "function",
    "function": {
      "name": "ripple_get_context",
      "description": "Fetch full workspace situational awareness: whoami, participants, recent dialogue, backlog items, active runs, subrun tree, open cards, and recent artifacts.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "limit": { "type": "integer" }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_list_items",
      "description": "List backlog items, active runs, and open decision cards in Ripple.",
      "parameters": { "type": "object", "properties": {}, "required": [] }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_create_item",
      "description": "Create a new backlog item or subtask for humans or agents to track.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "priority": { "type": "string" },
          "assignee_id": { "type": "string" },
          "parent_item_id": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["title"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_update_item",
      "description": "Update an existing backlog item or task (title, body, priority, status, assignee_id, parent_item_id, tags, result_url).",
      "parameters": {
        "type": "object",
        "properties": {
          "item_id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "priority": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "active", "done", "dropped"] },
          "assignee_id": { "type": "string" },
          "parent_item_id": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "result_url": { "type": "string" }
        },
        "required": ["item_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_claim",
      "description": "Claim an open backlog item to start a Run. Returns run id and epoch=1.",
      "parameters": {
        "type": "object",
        "properties": { "item_id": { "type": "string" } },
        "required": ["item_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_plan",
      "description": "Post or update the ordered step plan for a Run (bumps planVersion).",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "kind": { "type": "string", "enum": ["task", "gate"] }
              },
              "required": ["title"]
            }
          },
          "touches": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["run_id", "epoch", "steps"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_step",
      "description": "Update a step status (active/done/failed/skipped) and optional note.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" },
          "idx": { "type": "integer" },
          "status": { "type": "string", "enum": ["pending", "active", "done", "failed", "skipped"] },
          "note": { "type": "string" }
        },
        "required": ["run_id", "epoch", "idx", "status"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_spawn_subrun",
      "description": "Spawn a sub-agent and child Run under a parent Run (up to depth 3).",
      "parameters": {
        "type": "object",
        "properties": {
          "parent_run_id": { "type": "string" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "subagent_id": { "type": "string" },
          "subagent_name": { "type": "string" },
          "item_id": { "type": "string" },
          "parent_step_idx": { "type": "integer" }
        },
        "required": ["parent_run_id", "title"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_report_run",
      "description": "Report completion of a sub-agent run or primary run, attach PR/Drive/Doc artifacts, and notify parent run and workspace dialogue.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" },
          "summary": { "type": "string" },
          "status": { "type": "string", "enum": ["done", "failed"] },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["commit", "pr", "file", "url", "drive", "gdoc"] },
                "ref": { "type": "string" },
                "title": { "type": "string" },
                "url": { "type": "string" }
              },
              "required": ["kind", "ref"]
            }
          }
        },
        "required": ["run_id", "summary"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_artifact",
      "description": "Attach an artifact (commit, pr, file, url, drive, gdoc) with content_hash/SHA.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" },
          "step_idx": { "type": "integer" },
          "kind": { "type": "string", "enum": ["commit", "pr", "file", "url", "drive", "gdoc"] },
          "ref": { "type": "string" },
          "label": { "type": "string" },
          "url": { "type": "string" },
          "content_hash": { "type": "string" }
        },
        "required": ["run_id", "epoch", "step_idx", "kind", "ref"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_checkpoint",
      "description": "Report a safe checkpoint and receive any queued human steers and overlap warnings.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" },
          "after_step": { "type": "integer" }
        },
        "required": ["run_id", "epoch", "after_step"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_heartbeat",
      "description": "Send liveness heartbeat (every <=60s).",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" }
        },
        "required": ["run_id", "epoch"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_ack",
      "description": "Acknowledge a delivered human steer.",
      "parameters": {
        "type": "object",
        "properties": {
          "steer_id": { "type": "string" },
          "accepted": { "type": "boolean" },
          "note": { "type": "string" }
        },
        "required": ["steer_id", "accepted"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_ask",
      "description": "Raise a pin-bound decision Card (approve/choose/provide/review) for a human or agent.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "epoch": { "type": "integer" },
          "type": { "type": "string", "enum": ["approve", "choose", "provide", "review"] },
          "prompt": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "diff_preview": { "type": "string" }
        },
        "required": ["run_id", "epoch", "type", "prompt"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_answer_card",
      "description": "Answer an open Decision Card with CAS pin verification.",
      "parameters": {
        "type": "object",
        "properties": {
          "card_id": { "type": "string" },
          "option": { "type": "string" },
          "on_pin": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["card_id", "option", "on_pin"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_await",
      "description": "Wait for a Card to be answered, staled, expired, or withdrawn.",
      "parameters": {
        "type": "object",
        "properties": {
          "card_id": { "type": "string" },
          "timeout_ms": { "type": "integer" }
        },
        "required": ["card_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_post_message",
      "description": "Post a message to the workspace dialogue (workspace/main) or a run thread with @mentions.",
      "parameters": {
        "type": "object",
        "properties": {
          "body": { "type": "string" },
          "scope_kind": { "type": "string", "enum": ["workspace", "run", "step", "card"] },
          "scope_id": { "type": "string" }
        },
        "required": ["body"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ripple_read_messages",
      "description": "Read messages from the workspace dialogue or a run thread.",
      "parameters": {
        "type": "object",
        "properties": {
          "scope_kind": { "type": "string", "enum": ["workspace", "run", "step", "card"] },
          "scope_id": { "type": "string" }
        },
        "required": []
      }
    }
  }
]
