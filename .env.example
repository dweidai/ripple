PORT=8787
PUBLIC_URL=https://ripple.yourdomain.com
# Omit DATABASE_URL for zero-config in-memory dev mode; set it for Postgres in production
# DATABASE_URL=postgres://ripple:password@host:5432/ripple

# Set strong random tokens before deploying publicly (generate with: openssl rand -hex 24)
RIPPLE_HUMAN_TOKEN=rpl_human_change_me
RIPPLE_AGY_TOKEN=rpl_agy_change_me
RIPPLE_OPENCLAW_TOKEN=rpl_openclaw_change_me
RIPPLE_GROK_TOKEN=rpl_grok_change_me
RIPPLE_MUSE_TOKEN=rpl_muse_change_me
